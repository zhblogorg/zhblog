---
import { NavLinks } from "../config";
---

<footer class="border-t border-neutral-200 dark:border-neutral-800">
    <div class="container mx-auto px-6 py-12 max-w-2xl">
        <div class="space-y-4 text-xs text-center text-neutral-400 dark:text-neutral-500 font-mono">
            <nav class="flex items-center justify-center gap-2.5">
                {NavLinks.map( item => <a href={item.HREF}>{item.NAME}</a>)}
            </nav>
            <div class="text-[10px] space-y-2">
                <div>© 2026 Chinese Independent Bloggers' Guidelines.</div>
                <div>以诚实、理性、尊重与开放为原则，书写中文互联网应有的文字与思想。</div>
            </div>
        </div>
    </div>
</footer>