---
import { getEntry } from "astro:content";
import { SITE, CURRENT_VERSION } from "../config";
import MarkdownLayout from "../layouts/MarkdownLayout.astro";
import { render } from "astro:content";

const entry = await getEntry('guidelines', CURRENT_VERSION);
if (!entry) {
	throw new Error(`Content entry "guidelines/${CURRENT_VERSION}" not found.`);
}
const { Content } = await render(entry);
---
<MarkdownLayout pageName="Home">
	<h1>{SITE.TITLE}</h1>
	<p>一份面向中文独立博客创作者的公共倡议与参考规范，它旨在通过明确博客创作与发布的基本原则和最佳实践。</p>
	<Content />
</MarkdownLayout>