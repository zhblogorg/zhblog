---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from 'astro:content';

const deeds = (await getCollection("deed"))
	.filter(posts => !posts.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 1);
---

<BaseLayout title="中文独立博客创作契约">
	<main  class="container mx-auto p-6 max-w-2xl">
		<section class="">
			<div class="mt-16 mb-24 ">
				<h1 class="text-2xl md:text-3xl lg:text-4xl font-medium mb-6">构建一个更统一、更友好的中文博客生态</h1>
				<div class="flex items-center gap-2.5">
					<a href="/deeds/deed-1.0" class="px-5 py-1.5 rounded-lg bg-neutral-800 text-neutral-50 dark:bg-neutral-200 dark:text-neutral-900" aria-label="阅读当前正式版本">阅读正式版</a>
					<a href="/deeds" class="px-5 py-1.5 rounded-lg bg-neutral-100 dark:bg-neutral-800" aria-label="查看所有版本">版本列表</a>
				</div>
			</div>
		</section>

		<article>
			<p>中文博客契约全称《中文独立博客创作契约》是一份面向中文独立博客创作者的公共倡议与参考规范，它旨在通过明确博客创作与发布的基本原则和最佳实践。</p>
			<p>在信息流驱动与短内容泛滥的时代，中文独立博客是思想与文字的避风港。它承载着作者的独立思考、真实经验与美学追求。</p>
			<p>为维护博客文化的纯粹与公共价值，我们共同制定并自愿遵守此契约。</p>
			<p>本网站提供契约文本、解读说明与使用指引，供博客作者参考、自愿遵守或引用。本契约并非约束，它不隶属任何平台，也不参与流量排名，而是对更高写作精神的自觉承诺。</p>
		</article>
		
	</main>
</BaseLayout>