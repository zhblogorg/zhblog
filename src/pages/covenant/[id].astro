---
import { SITE } from "../../config";
import MarkdownLayout from "../../layouts/MarkdownLayout.astro";
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
    const covenants = await getCollection('covenant');
    return covenants.map(covenant => ({
        params: { id: covenant.id },
        props: { covenant },
    }));
}

const { covenant } = Astro.props;
const { Content } = await render(covenant);

const editUrl = `${SITE.GITHUB_URL}/edit/main/src/data${Astro.url.pathname}`
---

<MarkdownLayout
    title = {covenant.data.title}
    description = `名称：${covenant.data.title}；版本：${covenant.id}；发布日期：${covenant.data.pubDate.toDateString()}`
    noIndex = {covenant.data.draft ?? false}
>
    <section class="text-center pt-8">
        <h1>{covenant.data.title}</h1>
        <p><a href={new URL(Astro.url.pathname, Astro.site)} class="cursor-pointer" target="_blank">{new URL(Astro.url.pathname, Astro.site)}</a></p>
    </section>

    <hr>

    {
        covenant.data.deprecated ? (
            <p class="text-red-400">已弃用，此版本不再维护</p>
        ) : covenant.data.draft ? (
            <p class="text-orange-400">这是征求稿预览版，请前往 <a href={editUrl}>GitHub</a> 编辑或发送邮件反馈。</p>
        ) : null
    }
    <p>发布日期：{covenant.data.pubDate.toLocaleDateString('en-CA')}</p>
    {covenant.data.modDate && <p>修订日期：{covenant.data.modDate.toLocaleDateString('en-CA')}</p>}
    
    <hr>
    
    <Content />
</MarkdownLayout>