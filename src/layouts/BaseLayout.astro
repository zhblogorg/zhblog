---
import "../styles/global.css";
import { SITE } from "../config"
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
	title,
	description,
	emptyLayout,
	noIndex,
	pageName,
	pubDate,
	modDate,
	version
} : { 
	title?: string; 
	description?: string; 
	emptyLayout?: boolean;
	noIndex?: boolean;
	pageName?: string;
	pubDate?: Date;
	modDate?: Date;
	version?: string;
} = Astro.props;

const { pathname } = Astro.url;
const isHome = pathname === "/" || pathname === "/index.html";

const schema = isHome ? {
	"@context": "https://schema.org",
	"@type": "WebSite",
	"@id": Astro.url,
	"name": SITE.TITLE,
	"alternateName": ["中文独立博客创作契约", "中文独立博客契约", "中文博客创作契约", "中文博客契约"],
	"url": Astro.site
} : pageName === "guidelines" ? {
	"@context": "https://schema.org",
	"@type": "Article",
	"headline": title,
	"name": title,
	"url": Astro.url,
	"mainEntityOfPage": Astro.url,
	"inLanguage": "zh-CN",
	"description": description,
	"datePublished": pubDate,
	...(modDate && { "dateModified": modDate }),
	"version": version,
	"publisher": {
		"@type": "Organization",
		"name": SITE.TITLE,
		"url": Astro.site
	},
	"isPartOf": {
		"@type": "WebSite",
		"name": SITE.TITLE,
		"url": Astro.site
	},
} : null;
---

<html lang="zh-CN">
	<head>
		{noIndex && 
			<>
				<meta name="robots" content="noindex,nofollow" />
			</>
		}
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content= { description || SITE.DESCRIPTION } />
		<meta name="keywords" content={ SITE.KEYWORDS } />
		<meta name="generator" content={Astro.generator} />

		<link rel="canonical" href={Astro.url} />
		<link rel="icon" type="image/svg+xml" href={SITE.LOGO.src} />
		<link rel="sitemap" href="/sitemap-index.xml" />

		<title>{title || SITE.TITLE}</title>
		{(isHome || pageName == "guidelines") && ( <script type="application/ld+json" set:html={JSON.stringify(schema)} /> )}
	</head>
	<body class="bg-white dark:bg-neutral-950 text-neutral-900 dark:text-white antialiased selection:bg-neutral-200 selection:text-neutral-800 dark:selection:bg-neutral-600 dark:selection:text-neutral-200 break-all wrap-break-word">

        {!emptyLayout && <Header pageName={pageName} />}

        <slot />

		{!emptyLayout && <Footer />}

		{!import.meta.env.DEV && <script defer src="https://stats.betterapi.net/stats.js" data-website-id="45070bcb-d396-447c-92b3-81cf2a8c90b9"></script>}

	</body>
</html>