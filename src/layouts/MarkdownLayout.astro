---
import BaseLayout from "./BaseLayout.astro";

type Props = { 
	title?: string; 
	description?: string; 
	emptyLayout?: boolean;
    noIndex?: boolean;
}

const { title, description, emptyLayout = false, noIndex = false } = Astro.props;
---

<BaseLayout title={title} description={description} emptyLayout={emptyLayout} noIndex={noIndex}>
    <main class="container mx-auto px-6 py-8 space-y-8">
        <article>
            <slot />
        </article>
    </main>
</BaseLayout>