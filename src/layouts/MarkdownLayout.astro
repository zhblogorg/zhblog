---
import BaseLayout from "./BaseLayout.astro";

type Props = { 
	title?: string; 
	description?: string; 
	emptyLayout?: boolean;
    noIndex?: boolean;
    pageTitle?: string;
}

const { title, description, emptyLayout = false, noIndex = false, pageTitle } = Astro.props;
---

<BaseLayout title={title} description={description} emptyLayout={emptyLayout} noIndex={noIndex}>
    {pageTitle && 
        <section class="px-6 py-16 border-t border-neutral-100 bg-neutral-50">
                <h1 class="text-center max-w-3xl mx-auto text-2xl md:text-3xl lg:text-4xl font-medium">{pageTitle}</h1>
        </section>
    }
    <main class="container mx-auto px-6 py-8 space-y-8 max-w-3xl">
        <article>
            <slot />
        </article>
    </main>
</BaseLayout>